# ── REQUIRED, FREE ──────────────────────────────────────────────────────
# A local SQLite file — Prisma always uses this to generate migrations,
# even if you set up Turso below. Leave exactly as-is.
DATABASE_URL="file:./dev.db"

# Google Cloud Console (console.cloud.google.com) — free.
# Steps: create a project → enable "YouTube Data API v3" → Credentials →
# Create OAuth 2.0 Client ID (type: Web application) → add
# http://localhost:3000/api/youtube/callback as an authorized redirect URI.
# Tokens are per-account — connect each account from Settings, which tells
# you which YOUTUBE_REFRESH_TOKEN_xxx key to add below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/youtube/callback"
# Example — actual key names are shown after you connect an account in Settings:
# YOUTUBE_REFRESH_TOKEN_MAIN=""

# Reddit (reddit.com/prefs/apps) — free. See README "Setting up Reddit".
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_REDIRECT_URI="http://localhost:3000/api/reddit/callback"
# Example — actual key names are shown after you connect an account in Settings:
# REDDIT_REFRESH_TOKEN_MAIN=""

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── RECOMMENDED, FREE — real-time sync across multiple PCs ─────────────
# Leave both blank to use the plain local file only (fine for one PC).
# Fill both in once you've followed README "Setting up Turso" and every
# PC will read/write the same live database automatically.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ── PAID (external site, not an API key you set here) ──────────────────
# Suno (suno.com) — you generate songs directly on their site (or via
# Claude in Chrome). No key goes in this file; just have an active Suno
# plan good enough for commercial/downloadable output.

# ── REQUIRED IF you want the "✨ Enhance with AI" buttons to work ───────
# console.anthropic.com — this is a paid API, billed per call (typically a
# fraction of a cent per enhance click at this text length). Separate from
# any Claude.ai subscription you may have.
ANTHROPIC_API_KEY=""
# Optional — override the model used. Check docs.anthropic.com/en/docs/about-claude/models
# for current model ids if the default below ever errors as deprecated.
ANTHROPIC_MODEL=""

# ── REQUIRED IF Settings > Thumbnail mode = "ai" (default) ─────────────
# Replicate (replicate.com) — pay-per-second GPU billing, a background
# image costs a fraction of a cent to a few cents. Free trial credit on
# signup. Get a token from replicate.com/account/api-tokens.
REPLICATE_API_TOKEN=""
# Optional — a specific image model version. Leave blank to use the
# default (black-forest-labs/flux-schnell, fast and cheap).
REPLICATE_IMAGE_MODEL=""

# ── OPTIONAL, SKIP FOR NOW ──────────────────────────────────────────────
# Only needed if you later add the voice-polish step. Free tier available,
# paid beyond that. kits.ai
KITS_AI_API_KEY=""
KITS_AI_VOICE_MODEL_ID=""

# Only needed if you later add the accountability/commitment-device layer.
# Free trial, then paid if you keep it. beeminder.com
BEEMINDER_USERNAME=""
BEEMINDER_GOAL=""
BEEMINDER_AUTH_TOKEN=""

# Only needed if you later self-host an open-source song generator instead
# of using Suno directly. Not required for the current setup.
REPLICATE_MUSIC_MODEL=""
